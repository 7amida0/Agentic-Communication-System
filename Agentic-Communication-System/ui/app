def render_dashboard() -> None:

    with st.sidebar:
        st.markdown("##  Platform")
        if st.button("⟵ Back to Welcome", use_container_width=True):
            st.session_state.page = "welcome"
            st.rerun()
        st.divider()
        st.markdown("**Capabilities**")
        st.write("Multi-agent order allocation")
        st.write("Rule-based machine selection")
        st.write("Structured evidence grounding")
        st.write("Gemini-generated reasoning")
        st.write("Automatic explanation verification")

    st.title("Intelligent Manufacturing Decision System")
    st.caption(
        "Manufacturing Intelligence Platform. Deterministic machine allocation "
        "with grounded Gemini reasoning and automatic verification."
    )
    st.divider()

    input_col, network_col = st.columns([0.85, 1.35], gap="large")

    with input_col:
        st.subheader("Order Information")
        st.caption("Enter the manufacturing requirements.")

        with st.form("order_form"):
            order_id = st.text_input("Order ID", value="ORD-001")
            priority = st.selectbox("Priority", ["low", "medium", "high", "urgent"], index=2)
            required_capability = st.selectbox("Required Capability", ["milling", "turning"])
            deadline_minutes = st.number_input("Deadline in Minutes", min_value=1, max_value=10000, value=120, step=5)
            quality_requirement = st.selectbox("Quality Requirement", ["standard", "strict"], index=1)
            submitted = st.form_submit_button("▶ Run Allocation", use_container_width=True)

    with network_col:
        st.subheader("Current Machine Network")
        st.caption("Machine configuration currently available to the agents.")

        machine_columns = st.columns(len(MACHINE_DATA))
        for column, (machine_id, machine) in zip(machine_columns, MACHINE_DATA.items()):
            with column:
                with st.container(border=True):
                    st.markdown(f"### {machine_id}")

                    warnings = machine.get("active_warnings", [])
                    if machine.get("status", "").lower() != "available":
                        st.markdown(pill("Unavailable", "red"), unsafe_allow_html=True)
                    elif warnings:
                        st.markdown(pill("Warning", "gold"), unsafe_allow_html=True)
                    else:
                        st.markdown(pill("Available", "green"), unsafe_allow_html=True)

                    st.write(f"**Capability:** {machine['capability'].title()}")
                    st.write(f"**Queue Length:** {machine['queue_length']}")
                    st.write(f"**Processing Time:** {machine['estimated_processing_time_mins']} min")
                    st.write(f"**Maintenance:** {machine['maintenance_condition']:.0%}")
                    st.write("**Warnings:** " + (", ".join(warnings) if warnings else "None"))

    if not submitted:
        return

    if not order_id.strip():
        st.error("Enter an Order ID.")
        st.stop()

    order_payload = {
        "order_id": order_id.strip(),
        "priority": priority,
        "required_capability": required_capability,
        "deadline_minutes": int(deadline_minutes),
        "quality_requirement": quality_requirement,
    }

    st.divider()
    st.subheader("Live Agent Activity")

    activity_placeholder = st.empty()
    progress_bar = st.progress(0)

    timeline_steps = [
        "Order received", "Order validated", "Coordinator started",
        "Machine agents evaluated", "Quality assessment completed",
        "Maintenance assessment completed", "Decision rules applied",
        "Evidence package created", "Supporting information retrieved",
        "Gemini reasoning generated", "Verification completed",
        "Final recommendation completed",
    ]

    for index, step in enumerate(timeline_steps[:-1], start=1):
        activity_placeholder.write("" + step)
        progress_bar.progress(index / len(timeline_steps))
        time.sleep(0.04)

    start_time = time.perf_counter()

    try:
        recommendation = asyncio.run(run_allocation(**order_payload))
    except Exception as error:
        st.error("The workflow failed.")
        st.exception(error)
        st.stop()

    execution_time = time.perf_counter() - start_time
    result = recommendation.model_dump()

    progress_bar.progress(1.0)
    activity_placeholder.write("Final recommendation completed")

    selected_machine = str(result.get("selected_machine", "none"))
    rejected = result.get("machines_filtered_out", [])
    rejected_ids = {str(item.get("machine_id", "")) for item in rejected}

    verification = result.get("verification_result", {})
    verification_status = str(verification.get("status", "not_run")).lower()
    used_fallback = bool(verification.get("used_fallback", False))
    suitable_count = max(len(MACHINE_DATA) - len(rejected_ids), 0)

    st.divider()
    st.header("Final Recommendation")

    metric_columns = st.columns(5)
    metric_columns[0].metric("Selected Machine", selected_machine.upper())
    metric_columns[1].metric("Machines Evaluated", len(MACHINE_DATA))
    metric_columns[2].metric("Suitable Machines", suitable_count)
    metric_columns[3].metric("Verification", verification_status.upper())
    metric_columns[4].metric("Execution Time", f"{execution_time:.2f} s")

    st.subheader("Recommendation")
    with st.container(border=True):
        st.write(result.get("recommendation", "No recommendation returned."))

    st.subheader("Reasoning")
    with st.container(border=True):
        st.write(result.get("reasoning", result.get("justification", "No reasoning returned.")))

    st.subheader("Verification Result")
    if verification_status == "passed":
        st.markdown(pill("Verification Passed", "green"), unsafe_allow_html=True)
    else:
        st.markdown(pill("Verification Failed", "red"), unsafe_allow_html=True)

    st.write("")
    verification_columns = st.columns(3)
    verification_columns[0].metric("Status", verification_status.upper())
    verification_columns[1].metric("Issues Found", len(verification.get("issues_found", [])))
    verification_columns[2].metric("Fallback Used", "YES" if used_fallback else "NO")

    issues = verification.get("issues_found", [])
    if issues:
        st.write("**Detected Issues**")
        for issue in issues:
            st.write("- " + str(issue))

    st.header("Supporting Evidence")

    evidence = result.get("evidence", {})
    order_evidence = evidence.get("order", {})
    machine_statuses = evidence.get("machine_statuses", [])
    quality_assessments = evidence.get("quality_assessments", [])
    maintenance_assessments = evidence.get("maintenance_assessments", [])

    evidence_left, evidence_right = st.columns(2, gap="large")

    with evidence_left:
        st.subheader("Order Evidence")
        if order_evidence:
            order_rows = [{"Field": key.replace("_", " ").title(), "Value": value} for key, value in order_evidence.items()]
            st.dataframe(pd.DataFrame(order_rows), use_container_width=True, hide_index=True)

        st.subheader("Machine Status Evidence")
        if machine_statuses:
            st.dataframe(pd.DataFrame(machine_statuses), use_container_width=True, hide_index=True)

    with evidence_right:
        st.subheader("Quality Evidence")
        if quality_assessments:
            st.dataframe(pd.DataFrame(quality_assessments), use_container_width=True, hide_index=True)

        st.subheader("Maintenance Evidence")
        if maintenance_assessments:
            st.dataframe(pd.DataFrame(maintenance_assessments), use_container_width=True, hide_index=True)

    st.header("Retrieved Information")
    st.caption("Information selected from the evidence package before Gemini generated its explanation.")

    retrieved_information = result.get("retrieved_information", [])
    if retrieved_information:
        retrieved_rows = []
        for item in retrieved_information:
            retrieved_rows.append({
                "Type": item.get("type", "-"),
                "Machine": item.get("machine_id", "-"),
                "Retrieved Data": json.dumps(item.get("data", {}), ensure_ascii=False, default=str),
            })
        st.dataframe(pd.DataFrame(retrieved_rows), use_container_width=True, hide_index=True)
    else:
        st.info("No retrieved information.")

    action_col, rejected_col = st.columns(2, gap="large")

    with action_col:
        st.header("Required Actions")
        actions = result.get("required_actions", {})
        with st.container(border=True):
            st.markdown("#### Quality")
            st.write(actions.get("quality", "none"))
        with st.container(border=True):
            st.markdown("#### Maintenance")
            st.write(actions.get("maintenance", "none"))

    with rejected_col:
        st.header("Rejected Machines")
        if rejected:
            rejected_df = pd.DataFrame(rejected).rename(
                columns={"machine_id": "Machine", "reason": "Rejection Reason"}
            )
            st.dataframe(rejected_df, use_container_width=True, hide_index=True)
        else:
            st.success("No rejected machines.")

    st.header("Machine Decision Cards")

    decision_columns = st.columns(len(MACHINE_DATA))
    for column, (machine_id, machine) in zip(decision_columns, MACHINE_DATA.items()):
        with column:
            with st.container(border=True):
                st.markdown(f"### {machine_id}")

                if machine_id == selected_machine:
                    st.markdown(pill("Selected", "green"), unsafe_allow_html=True)
                    decision_reason = "Selected using queue length, quality risk and processing-time ranking."
                elif machine_id in rejected_ids:
                    st.markdown(pill("Rejected", "red"), unsafe_allow_html=True)
                    decision_reason = next(
                        (str(item.get("reason", "")) for item in rejected if str(item.get("machine_id", "")) == machine_id),
                        "Rejected.",
                    )
                else:
                    st.markdown(pill("Available", "gold"), unsafe_allow_html=True)
                    decision_reason = "Passed the filtering stage."

                st.write(f"**Capability:** {machine['capability'].title()}")
                st.write(f"**Queue:** {machine['queue_length']}")
                st.write(f"**Processing:** {machine['estimated_processing_time_mins']} min")
                st.write(f"**Maintenance:** {machine['maintenance_condition']:.0%}")
                st.write(f"**Decision:** {decision_reason}")

    st.header("Machine Comparison")

    chart_df = pd.DataFrame(
        [
            {
                "Machine": machine_id,
                "Queue Length": machine["queue_length"],
                "Processing Time": machine["estimated_processing_time_mins"],
                "Maintenance Condition": machine["maintenance_condition"] * 100,
            }
            for machine_id, machine in MACHINE_DATA.items()
        ]
    ).set_index("Machine")

    chart_left, chart_right = st.columns(2, gap="large")

    with chart_left:
        st.subheader("Queue and Processing Comparison")
        try:
            st.bar_chart(
                chart_df[["Queue Length", "Processing Time"]],
                use_container_width=True,
                color=["#1B8A5A", "#F0A73A"],
            )
        except TypeError:
            st.bar_chart(chart_df[["Queue Length", "Processing Time"]], use_container_width=True)

    with chart_right:
        st.subheader("Maintenance Condition")
        try:
            st.bar_chart(chart_df[["Maintenance Condition"]], use_container_width=True, color=["#17A398"])
        except TypeError:
            st.bar_chart(chart_df[["Maintenance Condition"]], use_container_width=True)

    timeline_col, summary_col = st.columns([1.2, 0.8], gap="large")

    with timeline_col:
        st.header("Agent Decision Timeline")
        timestamp = datetime.now().strftime("%H:%M:%S")
        for step in timeline_steps:
            st.write("**" + step + "**")
            st.caption(timestamp)

    with summary_col:
        st.header("Decision Summary")
        st.metric("Verification", verification_status.upper())
        st.metric("Retrieved Items", len(retrieved_information))
        st.metric("Fallback", "Used" if used_fallback else "Not Used")

    st.header("Detailed Machine Data")

    detail_rows = []
    for machine_id, machine in MACHINE_DATA.items():
        if machine_id == selected_machine:
            decision_status = "Selected"
        elif machine_id in rejected_ids:
            decision_status = "Rejected"
        else:
            decision_status = "Available"

        detail_rows.append({
            "Machine": machine_id,
            "Decision Status": decision_status,
            "Operational Status": machine["status"].title(),
            "Capability": machine["capability"].title(),
            "Queue": machine["queue_length"],
            "Processing Time (min)": machine["estimated_processing_time_mins"],
            "Maintenance": f"{machine['maintenance_condition']:.0%}",
            "Warnings": ", ".join(machine["active_warnings"]) or "None",
        })

    st.dataframe(pd.DataFrame(detail_rows), use_container_width=True, hide_index=True)

    st.header("Technical Details")

    with st.expander("Complete Evidence JSON"):
        st.json(evidence)
    with st.expander("Retrieved Information JSON"):
        st.json(retrieved_information)
    with st.expander("Complete Final Result"):
        st.json(result)

    export_data = {
        "order": order_payload,
        "selected_machine": result.get("selected_machine"),
        "recommendation": result.get("recommendation"),
        "reasoning": result.get("reasoning"),
        "evidence": result.get("evidence"),
        "required_actions": result.get("required_actions"),
        "rejected_machines": result.get("machines_filtered_out"),
        "retrieved_information": result.get("retrieved_information"),
        "verification_result": result.get("verification_result"),
        "execution_time_seconds": execution_time,
        "generated_at": datetime.now().isoformat(),
    }

    json_bytes = json.dumps(export_data, indent=2, ensure_ascii=False, default=str).encode("utf-8")
    pdf_bytes = build_pdf_report(order_payload, result, execution_time)

    st.header("Export")

    download_left, download_right = st.columns(2)
    with download_left:
        st.download_button(
            "Download JSON",
            data=json_bytes,
            file_name=f"{order_id.strip()}_allocation_result.json",
            mime="application/json",
            use_container_width=True,
        )
    with download_right:
        st.download_button(
            "Download PDF Report",
            data=pdf_bytes,
            file_name=f"{order_id.strip()}_allocation_report.pdf",
            mime="application/pdf",
            use_container_width=True,
        )


# =========================================================
# Router
# =========================================================

if st.session_state.page == "welcome":
    render_welcome()
else:
    render_dashboard()
