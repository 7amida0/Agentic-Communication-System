def build_pdf_report(order: dict[str, Any], result: dict[str, Any], execution_time: float) -> bytes:
    buffer = BytesIO()

    document = SimpleDocTemplate(
        buffer,
        pagesize=A4,
        rightMargin=18 * mm,
        leftMargin=18 * mm,
        topMargin=16 * mm,
        bottomMargin=16 * mm,
    )

    forest = colors.HexColor("#0F5C3B")
    green = colors.HexColor("#1B8A5A")
    mint = colors.HexColor("#E8F6EE")

    styles = getSampleStyleSheet()

    title_style = ParagraphStyle(
        "TitleCustom", parent=styles["Title"], fontName="Helvetica-Bold",
        fontSize=19, leading=23, textColor=forest, spaceAfter=6,
    )
    subtitle_style = ParagraphStyle(
        "SubtitleCustom", parent=styles["BodyText"], fontName="Helvetica",
        fontSize=9.5, leading=12, textColor=colors.HexColor("#5C6F65"), spaceAfter=10,
    )
    heading_style = ParagraphStyle(
        "HeadingCustom", parent=styles["Heading2"], fontName="Helvetica-Bold",
        fontSize=12.5, leading=15, textColor=green, spaceBefore=14, spaceAfter=6,
    )
    body_style = ParagraphStyle(
        "BodyCustom", parent=styles["BodyText"], fontName="Helvetica",
        fontSize=9, leading=13, textColor=colors.HexColor("#12261C"), alignment=TA_LEFT,
    )

    story: list[Any] = []

    story.append(Paragraph("Intelligent Manufacturing Decision Report", title_style))
    story.append(Paragraph("Generated: " + datetime.now().strftime("%d %B %Y, %H:%M:%S"), subtitle_style))
    story.append(HRFlowable(width="100%", thickness=1.4, color=green, spaceAfter=10))

    story.append(Paragraph("Order Information", heading_style))
    order_rows = [["Field", "Value"]]
    for key, value in order.items():
        order_rows.append([key.replace("_", " ").title(), str(value)])
    order_table = Table(order_rows, colWidths=[58 * mm, 105 * mm])
    order_table.setStyle(TableStyle([
        ("BACKGROUND", (0, 0), (-1, 0), forest),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
        ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, mint]),
        ("GRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#D9EEE1")),
        ("FONTSIZE", (0, 0), (-1, -1), 9),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
        ("TOPPADDING", (0, 0), (-1, -1), 5),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
    ]))
    story.append(order_table)

    story.append(Paragraph("Recommendation", heading_style))
    story.append(Paragraph(str(result.get("recommendation", "No recommendation.")), body_style))

    story.append(Paragraph("Reasoning", heading_style))
    story.append(Paragraph(
        str(result.get("reasoning", result.get("justification", "No reasoning."))), body_style,
    ))

    verification = result.get("verification_result", {})
    issues = verification.get("issues_found", [])

    story.append(Paragraph("Verification Result", heading_style))
    story.append(Paragraph(f"Status: {verification.get('status', 'not_run')}", body_style))
    story.append(Paragraph(f"Fallback used: {verification.get('used_fallback', False)}", body_style))
    story.append(Paragraph(
        "Issues found: " + ("; ".join(map(str, issues)) if issues else "None"), body_style,
    ))

    story.append(Paragraph("Required Actions", heading_style))
    actions = result.get("required_actions", {})
    action_table = Table(
        [
            ["Quality", str(actions.get("quality", "none"))],
            ["Maintenance", str(actions.get("maintenance", "none"))],
        ],
        colWidths=[45 * mm, 118 * mm],
    )
    action_table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#D9EEE1")),
        ("BACKGROUND", (0, 0), (0, -1), mint),
        ("FONTNAME", (0, 0), (0, -1), "Helvetica-Bold"),
        ("FONTSIZE", (0, 0), (-1, -1), 9),
        ("TOPPADDING", (0, 0), (-1, -1), 5),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 5),
    ]))
    story.append(action_table)

    story.append(Paragraph("Rejected Machines", heading_style))
    rejected = result.get("machines_filtered_out", [])
    if rejected:
        rejected_rows = [["Machine", "Reason"]]
        for item in rejected:
            rejected_rows.append([str(item.get("machine_id", "-")), str(item.get("reason", "-"))])
        rejected_table = Table(rejected_rows, colWidths=[35 * mm, 128 * mm])
        rejected_table.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#E15B4D")),
            ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
            ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
            ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#FCEBE8")]),
            ("GRID", (0, 0), (-1, -1), 0.5, colors.HexColor("#D9EEE1")),
            ("FONTSIZE", (0, 0), (-1, -1), 8),
        ]))
        story.append(rejected_table)
    else:
        story.append(Paragraph("No rejected machines.", body_style))

    story.append(PageBreak())
    story.append(Paragraph("Structured Evidence", heading_style))
    story.append(Preformatted(
        json.dumps(result.get("evidence", {}), indent=2, default=str), body_style, maxLineLength=100,
    ))

    story.append(Paragraph("Retrieved Information", heading_style))
    story.append(Preformatted(
        json.dumps(result.get("retrieved_information", []), indent=2, default=str), body_style, maxLineLength=100,
    ))

    story.append(Paragraph("Execution Summary", heading_style))
    story.append(Paragraph(f"Execution time: {execution_time:.2f} seconds", body_style))

    document.build(story)
    return buffer.getvalue()


